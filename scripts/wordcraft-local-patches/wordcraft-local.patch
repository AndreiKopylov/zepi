+fn cssa_margins(prl: &Prl) -> Option<[Option<f32>; 4]> {
+    // spra 6 leaves the operand's size byte in front of the CSSA.
+    let o = match prl.operand.split_first() {
+        Some((cb, rest)) if usize::from(*cb) + 1 == prl.operand.len() => rest,
+        _ => prl.operand,
+    };
