+        (*o.get(2)?, i16::from_le_bytes([*o.get(4)?, *o.get(5)?]))
+    } else if o.get(2).is_some_and(is_width) {
+        (*o.get(1)?, i16::from_le_bytes([*o.get(3)?, *o.get(4)?]))
+    } else {
+        return None;
+    };
+    let v = (w.max(0) as f32) / 20.0;
+    let mut m = [None; 4];
+    for (bit, slot) in [(0x01, 0), (0x02, 1), (0x04, 2), (0x08, 3)] {
+        if grfbrc & bit != 0 {
+            m[slot] = Some(v);
+        }
+    }
